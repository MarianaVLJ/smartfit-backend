  "item": [
    {
      "name": "Crear Socio",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// GIVEN (Dado que) envío los datos del prospecto al endpoint de socios",
              "// WHEN (Cuando) realizo la petición HTTP POST",
              "// THEN (Entonces) recibo un código de estado 201 (Creado exitosamente)",
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// AND (Y) los datos del socio creado son retornados correctamente",
              "pm.test(\"Socio es agregado correctamente\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.nombres).to.eql(\"Juan Perez\");",
              "    pm.expect(jsonData.estado).to.eql(\"Activo\");",
              "});",
              "",
              "// AND (Y) el tiempo de respuesta es menor a 5 segundos",
              "pm.test(\"Response time is less than 5s\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"dni\": \"72345678\",\r\n    \"nombres\": \"Juan Perez\",\r\n    \"email\": \"juan.perez@email.com\",\r\n    \"plan\": \"Black\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{project_host}}/socios",
          "host": [
            "{{project_host}}"
          ],
          "path": [
            "socios"
          ]
        },
        "description": "This is a GET request and it is used to \"get\" data from an endpoint. There is no request body for a GET request, but you can use query parameters to help specify the resource you want data on (e.g., in this request, we have `id=1`).\n\nA successful GET response will have a `200 OK` status, and should include some kind of response body - for example, HTML web content or JSON data."
      },
      "response": []
    },
